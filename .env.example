# =====================================================
# ScannTrack - Variables d'environnement
# =====================================================
# Copier ce fichier en .env.local et remplir les valeurs

# ----------------------------------------------------
# Supabase (base de données + auth + storage)
# ----------------------------------------------------
# 1. Créer un projet sur https://supabase.com
# 2. Aller dans Project Settings > API
# 3. Copier les valeurs ci-dessous
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...
# La service_role key NE DOIT JAMAIS être exposée côté client
SUPABASE_SERVICE_ROLE_KEY=ey...

# ----------------------------------------------------
# Resend (envoi d'emails - bons de sortie)
# ----------------------------------------------------
# 1. Créer un compte sur https://resend.com (3000 mails/mois gratuits)
# 2. Vérifier un domaine (ou utiliser onboarding@resend.dev pour les tests)
# 3. Créer une API key
RESEND_API_KEY=re_...
# Email d'expédition (doit être un domaine vérifié sur Resend)
EMAIL_FROM=bons@scanntrack.fr
# Email du gérant qui reçoit les bons de sortie
EMAIL_GERANT=patron@example.com

# ----------------------------------------------------
# Twilio (envoi SMS pour les alertes seuil)
# ----------------------------------------------------
# Alternative française : OVH SMS (voir lib/sms/ovh.ts)
# 1. Créer un compte sur https://twilio.com
# 2. Acheter un numéro français (~1€/mois)
# 3. Copier les credentials
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_FROM=+33...
# Numéro qui reçoit les SMS d'alerte stock
SMS_GERANT=+33612345678

# ----------------------------------------------------
# App
# ----------------------------------------------------
# URL publique de l'app (pour les liens dans les mails)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secret pour signer les sessions (générer avec: openssl rand -base64 32)
APP_SESSION_SECRET=changez-moi-en-prod

# ----------------------------------------------------
# Optionnel - Désactivation des features pour le dev
# ----------------------------------------------------
# Si "true", n'envoie pas vraiment les mails/SMS (logs en console)
DRY_RUN_NOTIFICATIONS=true
